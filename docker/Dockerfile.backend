# npm workspaces multi-stage (SafShekan-style layout under docker/)
FROM node:22-alpine AS base
WORKDIR /app

FROM base AS builder
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json .npmrc* ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/shared/package.json ./packages/shared/
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --legacy-peer-deps

COPY . .
RUN --mount=type=cache,target=/root/.npm \
    npm run build -w @helali/shared \
 && npx prisma generate --schema=apps/backend/prisma/schema.prisma \
 && npm run build -w @helali/backend

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apk add --no-cache ffmpeg wget \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs helali \
  && mkdir -p /app/data \
  && chown -R helali:nodejs /app

COPY --from=builder --chown=helali:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=helali:nodejs /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder --chown=helali:nodejs /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder --chown=helali:nodejs /app/apps/backend/package.json ./apps/backend/
COPY --from=builder --chown=helali:nodejs /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=builder --chown=helali:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=helali:nodejs /app/packages/shared/package.json ./packages/shared/
COPY --from=builder --chown=helali:nodejs /app/package.json ./package.json

USER helali
EXPOSE 3000
ENV PORT=3000
ENV BACKEND_PORT=3000

CMD ["node", "apps/backend/dist/main.js"]
