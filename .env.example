# Application
NODE_ENV=development

# Database
DATABASE_URL=postgresql://root:root@localhost:5432/helali_database?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio99
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false

# Storage (local = filesystem in dev, minio = object storage)
STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=storage

# Backend
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1

# Cookie
COOKIE_SECURE=false

# API Payload Encryption (AES-256-GCM)
API_ENCRYPTION_ENABLED=false
API_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
NEXT_PUBLIC_API_ENCRYPTION_ENABLED=false
NEXT_PUBLIC_API_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
