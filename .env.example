NODE_ENV=production
PORT=3000

# Host publish (SafShekan-style compose)
BACKEND_PORT=3030
FRONTEND_PORT=3031
NGINX_PORT=3032

BACKEND_IMAGE=ghcr.io/OWNER/helali-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/helali-frontend:latest

POSTGRES_DB=helali_database
POSTGRES_USER=root
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
DATABASE_URL=postgresql://root:replace_with_a_secure_postgres_password@postgres:5432/helali_database?schema=public

REDIS_PASSWORD=replace_with_a_secure_redis_password
REDIS_URL=redis://:replace_with_a_secure_redis_password@redis:6379
REDIS_MAXMEMORY=128mb

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

MINIO_ACCESS_KEY=minio99
MINIO_SECRET_KEY=minio123
MINIO_PUBLIC_ENDPOINT=5.159.49.36
MINIO_PUBLIC_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_USE_SSL=false
STORAGE_DRIVER=minio

NEXT_PUBLIC_API_URL=https://helali.rmhosseini.ir/api/v1
NEXT_PUBLIC_SITE_URL=https://helali.rmhosseini.ir
BACKEND_PUBLIC_URL=https://helali.rmhosseini.ir
CORS_ORIGIN=https://helali.rmhosseini.ir
COOKIE_SECURE=false
API_ENCRYPTION_ENABLED=false
