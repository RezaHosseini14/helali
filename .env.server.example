# Remote server infra (5.159.49.36) — copy to .env when connecting from your dev machine
# Only Helali containers; does not affect other services on the server.

NODE_ENV=development

DATABASE_URL=postgresql://root:root@5.159.49.36:5433/helali_database?schema=public
REDIS_URL=redis://5.159.49.36:6380

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ENDPOINT=5.159.49.36
MINIO_PORT=9010
MINIO_ACCESS_KEY=minio99
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false

STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=storage

BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://5.159.49.36:4000/api/v1
API_URL=http://5.159.49.36:4000/api/v1

COOKIE_SECURE=false

API_ENCRYPTION_ENABLED=false
