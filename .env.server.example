# Remote server infra (5.159.49.36) — copy to .env when connecting from your dev machine
# Only Helali containers; does not affect other services on the server.

NODE_ENV=development

DATABASE_URL=postgresql://root:root@5.159.49.36:5433/helali_database?schema=public&connect_timeout=30&pool_timeout=30&connection_limit=10
REDIS_URL=redis://5.159.49.36:6380
BULLMQ_PREFIX=helali-prod

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ENDPOINT=5.159.49.36
MINIO_PORT=9010
MINIO_PUBLIC_ENDPOINT=5.159.49.36
MINIO_PUBLIC_PORT=9010
MINIO_ACCESS_KEY=minio99
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false

STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=storage

BACKEND_PORT=4000
CORS_ORIGIN=https://helali.rmhosseini.ir,http://localhost:3000

NEXT_PUBLIC_API_URL=https://helali.rmhosseini.ir/api/v1
NEXT_PUBLIC_SITE_URL=https://helali.rmhosseini.ir
API_URL=http://5.159.49.36:4000/api/v1

# Public site (Docker frontend on server / nginx)
# https://helali.rmhosseini.ir

COOKIE_SECURE=false

API_ENCRYPTION_ENABLED=false
API_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
NEXT_PUBLIC_API_ENCRYPTION_ENABLED=false
NEXT_PUBLIC_API_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
