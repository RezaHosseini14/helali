# Copy to the server once (e.g. /opt/helali-frontend/.env). GitHub Actions only updates FRONTEND_IMAGE.

FRONTEND_IMAGE=ghcr.io/OWNER/helali-frontend:replace-with-sha

# Must be HTTPS same-origin (or empty → browser uses /api/v1). Never http://IP:4000 on an HTTPS site.
NEXT_PUBLIC_API_URL=https://helali.rmhosseini.ir/api/v1
NEXT_PUBLIC_SITE_URL=https://helali.rmhosseini.ir
API_URL=http://helali-backend:4000/api/v1
BACKEND_INTERNAL_ORIGIN=http://helali-backend:4000
MINIO_PUBLIC_ENDPOINT=5.159.49.36
MINIO_PUBLIC_PORT=9010
MINIO_USE_SSL=false
