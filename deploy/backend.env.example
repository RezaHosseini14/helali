# Copy to the server once (e.g. /opt/helali-app/.env).
# GitHub Actions updates BACKEND_IMAGE / BACKEND_HOST_PORT and keeps BACKEND_IMAGE_PREV for rollback.

BACKEND_IMAGE=ghcr.io/OWNER/helali-backend:replace-with-sha
# BACKEND_IMAGE_PREV=
BACKEND_HOST_PORT=3030

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

BACKEND_PUBLIC_URL=https://helali.rmhosseini.ir
CORS_ORIGIN=https://helali.rmhosseini.ir,http://5.159.49.36:3031,http://localhost:3000
MINIO_PUBLIC_ENDPOINT=5.159.49.36
MINIO_PUBLIC_PORT=9010
MINIO_ACCESS_KEY=minio99
MINIO_SECRET_KEY=minio123
# Keep API cache isolated from local backends that share this Redis.
API_CACHE_PREFIX=helali-prod
BULLMQ_PREFIX=helali-prod
